ts \u003d [\"09:00\", \"09:30\", \"10:00\", \"10:30\", \"11:00\", \"11:30\", \"12:00\", \"12:30\", \"13:00\", \"13:30\", \"14:00\", \"14:30\", \"15:00\", \"15:30\", \"16:00\", \"16:30\", \"17:00\", \"17:30\", \"18:00\", \"18:30\", \"19:00\", \"19:30\"];\n\n  useEffect(() \u003d\u003e {\n    fetchInitialData();\n  }, []);\n\n  async function fetchInitialData() {\n    const { data: s } \u003d await supabase.from(\u0027services\u0027).select(\u0027*\u0027).eq(\u0027is_active\u0027, true);\n    const { data: b } \u003d await supabase.from(\u0027barbers\u0027).select(\u0027*\u0027).eq(\u0027is_active\u0027, true);\n    if (s) setServices(s);\n    if (b) setBarbers(b);\n  }\n\n  const handleBooking \u003d async () \u003d\u003e {\n    if (!selectedBarber || !selectedService) return;\n\n    const { error } \u003d await supabase.from(\u0027appointments\u0027).insert([{\n      barber_id: selectedBarber.id,\n      service_id: selectedService.id,\n      appointment_date: selectedDate,\n      appointment_time: selectedTime,\n      client_name: clientData.name,\n      client_whatsapp: clientData.whatsapp\n    }]);\n\n    if (!error) {\n      const msg \u003d `Hola bro, tenes tu turno guardado para ${selectedService.name} el dia ${selectedDate} a las ${selectedTime} con ${selectedBarber.name}. Abrazo!`;\n      window.open(`https://wa.me/${selectedBarber.whatsapp_number}?text\u003d${encodeURIComponent(msg)}`, \u0027_blank\u0027);\n      setStep(6); // Pantalla de éxito\n    } else {\n      alert(\"Error al reservar: El horario podría estar ocupado.\");\n    }\n  };\n\n  return (\n    \u003cdiv className\u003d\"min-h-screen bg-dark text-white p-6 font-sans\"\u003e\n      {/* Header Estilo Urbano */}\n      \u003cheader className\u003d\"text-center mb-10\"\u003e\n        \u003ch1 className\u003d\"text-5xl font-display font-black tracking-tighter italic\"\u003eIL BARBIERE\u003c/h1\u003e\n        \u003cp className\u003d\"text-gray-400 uppercase tracking-widest text-xs mt-2\"\u003eArroyo Seco • Est. 2024\u003c/p\u003e\n      \u003c/header\u003e\n\n      \u003cdiv className\u003d\"max-w-md mx-auto bg-card p-6 rounded-2xl border border-white/5 shadow-2xl\"\u003e\n        \n        {/* Paso 1: Servicios */}\n        {step \u003d\u003d\u003d 1 \u0026\u0026 (\n          \u003cdiv className\u003d\"space-y-4\"\u003e\n            \u003ch2 className\u003d\"text-xl font-bold mb-4 uppercase italic\"\u003e1. Elegí Servicio\u003c/h2\u003e\n            {services.map(s \u003d\u003e (\n              \u003cbutton key\u003d{s.id} onClick\u003d{() \u003d\u003e { setSelectedService(s); setStep(2); }}\n                className\u003d\"w-full flex justify-between p-4 border border-white/10 rounded-xl hover:bg-white hover:text-black transition-all group\"\u003e\n                \u003cspan className\u003d\"font-bold\"\u003e{s.name}\u003c/span\u003e\n                \u003cspan className\u003d\"text-gray-400 group-hover:text-black\"\u003e${s.price}\u003c/span\u003e\n              \u003c/button\u003e\n            ))}\n          \u003c/div\u003e\n        )}\n\n        {/* Paso 2: Barberos */}\n        {step \u003d\u003d\u003d 2 \u0026\u0026 (\n          \u003cdiv className\u003d\"space-y-4\"\u003e\n            \u003ch2 className\u003d\"text-xl font-bold mb-4 uppercase italic\"\u003e2. Elegí Barbero\u003c/h2\u003e\n            {barbers.map(b \u003d\u003e (\n              \u003cbutton key\u003d{b.id} onClick\u003d{() \u003d\u003e { setSelectedBarber(b); setStep(3); }}\n                className\u003d\"w-full p-4 border border-white/10 rounded-xl hover:bg-white hover:text-black font-bold transition-all\"\u003e\n                {b.name}\n              \u003c/button\u003e\n            ))}\n          \u003c/div\u003e\n        )}\n\n        {/* Paso 3: Fecha */}\n        {step \u003d\u003d\u003d 3 \u0026\u0026 (\n          \u003cdiv className\u003d\"space-y-4\"\u003e\n            \u003ch2 className\u003d\"text-xl font-bold mb-4 uppercase italic\"\u003e3. Fecha\u003c/h2\u003e\n     